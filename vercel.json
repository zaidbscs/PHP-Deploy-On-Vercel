{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/calculate",
      "dest": "/api/calculate.php"
    },
    {
      "src": "/process",
      "dest": "/api/process.php"
    },
    {
      "src": "/",
      "dest": "/api/index.php"
    }
  ]
}
